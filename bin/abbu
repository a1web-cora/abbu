#!/usr/bin/env ruby
# bin/abbu
# frozen_string_literal: true

$LOAD_PATH.unshift File.expand_path('../lib', __dir__)

require 'optparse'
require 'abbu'

options = {
  format: nil,
  output: nil,
  dedupe: false,
  live: nil,
  stats: false
}

parser = OptionParser.new do |opts|
  opts.banner = 'Usage: abbu [file.abbu] [options]'

  opts.on('-f', '--format FORMAT', %w[csv json vcard], 'Export format (csv, json, vcard)') do |f|
    options[:format] = f
  end

  opts.on('-o', '--output FILE', 'Output file (default: stdout)') do |o|
    options[:output] = o
  end

  opts.on('--stats', 'Print contact statistics') do
    options[:stats] = true
  end

  opts.on('--dedupe', 'Find and print duplicate contacts') do
    options[:dedupe] = true
  end

  opts.on('--live [PATH]', 'Read a live macOS AddressBook directory (default: current user store)') do |path|
    options[:live] = path || true
  end

  opts.on('-v', '--version', 'Print version') do
    puts "abbu #{Abbu::VERSION}"
    exit
  end

  opts.on('-h', '--help', 'Print this help') do
    puts opts
    exit
  end
end

parser.parse!

file = ARGV.shift
live_mode = !options[:live].nil?
live_path = options[:live] == true ? file : options[:live]

if file.nil? && !live_mode
  puts parser
  exit 1
end

handle_live_error = lambda do |&block|
  block.call
rescue Abbu::LiveStore::Error => e
  warn "abbu: #{e.message}"
  exit 1
end

input = handle_live_error.call do
  live_mode ? Abbu.open_live(live_path) : Abbu.open(file)
end
contacts = nil
load_contacts = -> { contacts ||= handle_live_error.call { input.contacts } }

if options[:stats]
  contacts = load_contacts.call
  puts "Total contacts : #{contacts.count}"
  puts "With email     : #{contacts.count { |c| c.emails.any? }}"
  puts "With phone     : #{contacts.count { |c| c.phones.any? }}"
  exit
end

if options[:dedupe]
  require 'abbu/utils/deduplicator'
  dupes = Abbu::Utils::Deduplicator.new(load_contacts.call).duplicates
  if dupes.empty?
    puts 'No duplicates found.'
  else
    dupes.each do |email, contacts|
      puts "Duplicate: #{email}"
      contacts.each { |c| puts "  - #{c.full_name}" }
    end
  end
  exit
end

case options[:format]
when 'csv'
  exporter = Abbu::Exporters::CsvExporter.new(load_contacts.call)
  options[:output] ? exporter.to_file(options[:output]) : exporter.to_stdout
when 'json'
  exporter = Abbu::Exporters::JsonExporter.new(load_contacts.call)
  options[:output] ? exporter.to_file(options[:output]) : exporter.to_stdout
when 'vcard'
  exporter = Abbu::Exporters::VcardExporter.new(load_contacts.call)
  options[:output] ? exporter.to_file(options[:output]) : exporter.to_stdout
else
  puts parser
  exit 1
end
