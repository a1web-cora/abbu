#!/usr/bin/env ruby
# bin/abbu
# frozen_string_literal: true

$LOAD_PATH.unshift File.expand_path('../lib', __dir__)

require 'optparse'
require 'abbu'

options = {
  format: nil,
  output: nil,
  dedupe: false,
  email: nil,
  phone: nil,
  search: nil,
  stats: false
}

parser = OptionParser.new
parser.banner = 'Usage: abbu <file.abbu> [options]'

parser.on('-f', '--format FORMAT', %w[csv json vcard], 'Export format (csv, json, vcard)') do |f|
  options[:format] = f
end

parser.on('-o', '--output FILE', 'Output file (default: stdout)') do |o|
  options[:output] = o
end

parser.on('--stats', 'Print contact statistics') do
  options[:stats] = true
end

parser.on('--dedupe', 'Find and print duplicate contacts') do
  options[:dedupe] = true
end

parser.on('--search TERM', 'Find contacts by partial name or email') do |term|
  options[:search] = term
end

parser.on('--email ADDRESS', 'Find contacts by exact normalized email') do |address|
  options[:email] = address
end

parser.on('--phone NUMBER', 'Find contacts by exact normalized phone number') do |number|
  options[:phone] = number
end

parser.on('-v', '--version', 'Print version') do
  puts "abbu #{Abbu::VERSION}"
  exit
end

parser.on('-h', '--help', 'Print this help') do
  puts parser
  exit
end

parser.parse!

file = ARGV.shift

if file.nil?
  puts parser
  exit 1
end

archive = Abbu.open(file)

search_options = options.values_at(:search, :email, :phone).compact
if search_options.length > 1
  warn 'Use only one of --search, --email, or --phone.'
  exit 1
end

if search_options.any?
  results = if options[:search]
              archive.search(options[:search])
            elsif options[:email]
              archive.find_by_email(options[:email])
            else
              archive.find_by_phone(options[:phone])
            end

  results.each do |contact|
    fields = [
      contact.full_name,
      contact.emails.filter_map { |email| email[:address] }.join(','),
      contact.phones.filter_map { |phone| phone[:number] }.join(','),
      contact.source&.fetch(:relative_path, nil)
    ]
    puts fields.map { |field| field.to_s.gsub(/[\t\r\n]/, ' ') }.join("\t")
  end
  exit(results.any? ? 0 : 1)
end

if options[:stats]
  contacts = archive.contacts
  puts "Total contacts : #{contacts.count}"
  puts "With email     : #{contacts.count { |c| c.emails.any? }}"
  puts "With phone     : #{contacts.count { |c| c.phones.any? }}"
  exit
end

if options[:dedupe]
  require 'abbu/utils/deduplicator'
  dupes = Abbu::Utils::Deduplicator.new(archive.contacts).duplicates
  if dupes.empty?
    puts 'No duplicates found.'
  else
    dupes.each do |email, contacts|
      puts "Duplicate: #{email}"
      contacts.each { |c| puts "  - #{c.full_name}" }
    end
  end
  exit
end

case options[:format]
when 'csv'
  exporter = Abbu::Exporters::CsvExporter.new(archive.contacts)
  options[:output] ? exporter.to_file(options[:output]) : exporter.to_stdout
when 'json'
  exporter = Abbu::Exporters::JsonExporter.new(archive.contacts)
  options[:output] ? exporter.to_file(options[:output]) : exporter.to_stdout
when 'vcard'
  exporter = Abbu::Exporters::VcardExporter.new(archive.contacts)
  options[:output] ? exporter.to_file(options[:output]) : exporter.to_stdout
else
  puts parser
  exit 1
end
