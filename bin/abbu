#!/usr/bin/env ruby
# bin/abbu
# frozen_string_literal: true

$LOAD_PATH.unshift File.expand_path('../lib', __dir__)

require 'json'
require 'optparse'
require 'abbu'

options = {
  format: nil,
  output: nil,
  extract_images: nil,
  dedupe: false,
  email: nil,
  json: false,
  live: nil,
  live_path: nil,
  phone: nil,
  search: nil,
  schema: false,
  stats: false,
  strict: false
}

parser = OptionParser.new
parser.banner = 'Usage: abbu <file.abbu> [options] | abbu --live [options] | abbu --live-path PATH [options]'

parser.on('-f', '--format FORMAT', %w[csv json vcard], 'Export format (csv, json, vcard)') do |f|
  options[:format] = f
end

parser.on('-o', '--output FILE', 'Output file (default: stdout)') do |o|
  options[:output] = o
end

parser.on('--extract-images DIR', 'Copy contact images to DIR') do |dir|
  options[:extract_images] = dir
end

parser.on('--stats', 'Print contact statistics') do
  options[:stats] = true
end

parser.on('--dedupe', 'Find and print duplicate contacts') do
  options[:dedupe] = true
end

parser.on('--search TERM', 'Find contacts by partial name or email') do |term|
  options[:search] = term
end

parser.on('--strict', 'Raise on unsupported or corrupt optional data') do
  options[:strict] = true
end

parser.on('--schema', 'Print SQLite schema diagnostics as JSON') do
  options[:schema] = true
end

parser.on('--email ADDRESS', 'Find contacts by exact normalized email') do |address|
  options[:email] = address
end

parser.on('--phone NUMBER', 'Find contacts by exact normalized phone number') do |number|
  options[:phone] = number
end

parser.on('--json', 'Emit search results as structured JSON instead of TSV') do
  options[:json] = true
end

timestamp_bounds = %w[since before]
%w[created modified].each do |kind|
  timestamp_bounds.each do |bound|
    parser.on("--#{kind}-#{bound} TIMESTAMP", "Filter #{kind} timestamp (ISO 8601 with timezone)") do |value|
      options[:date_filters] ||= {}
      options[:date_filters][:"#{kind}_at"] ||= {}
      options[:date_filters][:"#{kind}_at"][bound.to_sym] = value
    end
  end
end

parser.on('-v', '--version', 'Print version') do
  puts "abbu #{Abbu::VERSION}"
  exit
end

parser.on('-h', '--help', 'Print this help') do
  puts parser
  exit
end

parser.on('--live', 'Auto-discover the current macOS Contacts store') do
  options[:live] = true
end

parser.on('--live-path PATH', 'Read the specified live AddressBook directory') do |path|
  options[:live_path] = path
end

parser.parse!

live_mode = options[:live] || !options[:live_path].nil?
live_path = options[:live_path]

if options[:live] && live_path
  warn 'Use only one of --live or --live-path PATH.'
  exit 1
end

if live_mode && ARGV.any?
  warn 'Unexpected positional arguments in live mode; use --live-path PATH for an explicit store.'
  exit 1
end

file = ARGV.shift

if file.nil? && !live_mode
  puts parser
  exit 1
end

archive = nil

at_exit do
  next if archive.nil? || archive.diagnostics.empty?

  warn "Diagnostics: #{archive.diagnostics.count}"
  archive.diagnostics.each do |diagnostic|
    warn "- #{diagnostic.category}: #{diagnostic.message} [#{diagnostic.source}]"
  end
end

begin
  if live_mode && options.values_at(:extract_images, :schema, :search, :email, :phone, :json, :date_filters).any?
    warn '--live supports --stats, --dedupe, --format, and --strict; archive-only options are not supported.'
    exit 1
  end
  if options[:date_filters]
    if options.values_at(:extract_images, :schema, :stats, :dedupe, :format, :output).any?
      raise ArgumentError, 'timestamp filters cannot be combined with export, stats, schema, dedupe, or extraction'
    end

    options[:date_filters].each { |field, bounds| Abbu::TimestampRange.new(field, **bounds) }
  end
  archive = live_mode ? Abbu.open_live(live_path, strict: options[:strict]) : Abbu.open(file, strict: options[:strict])

  if options[:extract_images]
    result = archive.extract_images(options[:extract_images])
    puts "Extracted #{result.files.count} image(s) to #{File.expand_path(options[:extract_images])}"
    result.diagnostics.each do |diagnostic|
      warn "Image #{diagnostic[:code]}: #{diagnostic[:contact_name]} (#{diagnostic[:image_uri]})"
    end
    exit unless options[:format] || options[:stats] || options[:dedupe]
  end

  if options[:schema]
    puts JSON.pretty_generate(archive.schema_report)
    exit
  end

  search_options = options.values_at(:search, :email, :phone).compact
  if search_options.length > 1
    warn 'Use only one of --search, --email, or --phone.'
    exit 1
  end

  if options[:json] && search_options.empty? && !options[:date_filters]
    warn '--json requires --search, --email, or --phone (or a timestamp filter).'
    exit 1
  end

  if search_options.any? || options[:date_filters]
    results = if options[:search]
                archive.search(options[:search])
              elsif options[:email]
                archive.find_by_email(options[:email])
              elsif options[:phone]
                archive.find_by_phone(options[:phone])
              else
                archive.query
              end

    options.fetch(:date_filters, {}).each do |field, bounds|
      results = results.date_range(field, **bounds)
    end

    if options[:json]
      Abbu::Exporters::JsonExporter.new(results).to_stdout
    else
      results.each do |contact|
        fields = [
          contact.full_name,
          contact.emails.filter_map { |email| email[:address] }.join(','),
          contact.phones.filter_map { |phone| phone[:number] }.join(','),
          contact.source&.fetch(:relative_path, nil)
        ]
        puts fields.map { |field| field.to_s.gsub(/[\t\r\n]/, ' ') }.join("\t")
      end
    end
    exit(results.any? ? 0 : 1)
  end

  if options[:stats]
    contacts = archive.contacts
    puts "Total contacts : #{contacts.count}"
    puts "With email     : #{contacts.count { |c| c.emails.any? }}"
    puts "With phone     : #{contacts.count { |c| c.phones.any? }}"
    exit
  end

  if options[:dedupe]
    require 'abbu/utils/deduplicator'
    dupes = Abbu::Utils::Deduplicator.new(archive.contacts).duplicates
    if dupes.empty?
      puts 'No duplicates found.'
    else
      dupes.each do |email, contacts|
        puts "Duplicate: #{email}"
        contacts.each { |c| puts "  - #{c.full_name}" }
      end
    end
    exit
  end

  case options[:format]
  when 'csv'
    exporter = Abbu::Exporters::CsvExporter.new(archive.contacts)
    options[:output] ? exporter.to_file(options[:output]) : exporter.to_stdout
  when 'json'
    exporter = Abbu::Exporters::JsonExporter.new(archive.contacts)
    options[:output] ? exporter.to_file(options[:output]) : exporter.to_stdout
  when 'vcard'
    exporter = Abbu::Exporters::VcardExporter.new(archive.contacts)
    options[:output] ? exporter.to_file(options[:output]) : exporter.to_stdout
  else
    puts parser
    exit 1
  end
rescue Abbu::LiveStore::Error => e
  warn "abbu: #{e.message}"
  exit 1
rescue Abbu::ParseError, ArgumentError => e
  warn "abbu: #{e.message}"
  exit 2
end
